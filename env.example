# Required — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Required — MongoDB (songs library)
MONGODB_URI=
# Optional DB name (default: guess-the-song)
MONGODB_DB=guess-the-song

# Optional playlist IDs (one per difficulty). If empty, sync uses search seeds.
SPOTIFY_PLAYLIST_EASY=
SPOTIFY_PLAYLIST_MEDIUM=
SPOTIFY_PLAYLIST_HARD=
SPOTIFY_PLAYLIST_EXPERT=
SPOTIFY_PLAYLIST_IMPOSSIBLE=

# Cloudflare R2 — hosted “From the start” audio clips
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN base (no trailing slash), e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=

# Optional. If set, POST /api/sync requires header x-sync-secret.
# Leave empty for local development so the in-app Sync button works.
SYNC_SECRET=

# Optional. Protects /admin APIs via x-admin-secret (falls back to SYNC_SECRET).
ADMIN_SECRET=
